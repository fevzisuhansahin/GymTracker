# Supabase - Cloud project settings
# Find these in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Only used server-side (migrations, admin). NEVER prefix with NEXT_PUBLIC_.
# In Coolify: mark as Runtime (not Build-time).
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Your production domain (used for OAuth redirects)
NEXT_PUBLIC_SITE_URL=https://gymtracker.yourdomain.com
